# `dafny run` emits these next to the source .dfy (generated, not source)
examples/*.cs
examples/*.csproj
# compiled binaries dropped by `dafny run` (no extension) under examples/
examples/demo
test/*.cs
test/*.csproj

# fw/: generated C++ from the boost-free translation checks (not source)
fw/*.cpp
fw/*.h
fw/*.o
fw/*-cpp/
fw/*.cs
fw/*.csproj
fw/FwTest
fw/*_exe
